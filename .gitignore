# ============================================================================
# Gitignore — SismoPaz / MapaSismos Sprint 1
# Archivos y carpetas que NO se suben a GitHub
# ============================================================================

# --- Dependencias ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# --- Next.js (frontend) ---
.next/
out/
frontend/.next/
frontend/out/

# --- Builds generales ---
dist/
build/
*.tsbuildinfo
frontend/*.tsbuildinfo
backend/dist/

# --- Entorno y credenciales (NUNCA subir) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local
backend/.env

# --- IDE y editores ---
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Base de datos local ---
*.sqlite
*.db
*.db-journal

# --- Scripts locales (no subir al repo) ---
*.bat
*.ps1
temp-verify/
.tmp-verify/

# --- Carpeta temporal de verificación ---
.tmp-verify/
